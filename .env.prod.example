# ──────────────────────────────────────────────────────────────────────────────
#  DzRent — production environment (docker-compose.prod.yml)
#
#  Copy to `.env` on the VM (or have the deploy workflow write it from secrets).
#  This single file is BOTH the backend container's env_file AND the source
#  Compose interpolates ${...} from. Generate secrets with: openssl rand -hex 32
#  NEVER commit the real .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000
APP_SECRET=CHANGE_ME_hex32

# Same-origin in production (nginx serves the app and proxies /api), so the only
# required origin is the agency host. Add others if accessed cross-origin.
CORS_ORIGINS=https://dzrent-agence.rayanemelzi.dev

# ── Reverse-proxy wiring (Compose interpolation only) ─────────────────────────
# Public API URL baked into the frontend at build time (same-origin via nginx).
NEXT_PUBLIC_API_URL=https://dzrent-agence.rayanemelzi.dev/api/v1
# Host ports the containers bind to on 127.0.0.1 (nginx upstreams).
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=3002

# ── Database (internal compose hostname: postgres) ────────────────────────────
POSTGRES_USER=dzrent
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=dzrent
DATABASE_URL="postgresql://dzrent:CHANGE_ME_strong_db_password@postgres:5432/dzrent?schema=public"
DIRECT_URL="postgresql://dzrent:CHANGE_ME_strong_db_password@postgres:5432/dzrent?schema=public"

# ── JWT (access + refresh must be DIFFERENT secrets) ──────────────────────────
JWT_SECRET=CHANGE_ME_access_hex32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_hex32
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis (internal compose hostname: redis) ──────────────────────────────────
REDIS_URL=redis://redis:6379

# ── SMS (placeholders => ConsoleSmsService: OTP printed to backend logs) ──────
# Replace with live Twilio credentials to send real SMS.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12125550000

# ── Object storage (internal compose hostname: minio) ─────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=dzrentminio
S3_SECRET_KEY=CHANGE_ME_strong_minio_password
S3_BUCKET_KYC=dzrent-kyc
S3_BUCKET_VEHICLES=dzrent-vehicles
S3_BUCKET_CONTRACTS=dzrent-contracts

# ── GPS webhook HMAC secret ───────────────────────────────────────────────────
GPS_INGEST_SECRET=CHANGE_ME_hex32
