# ══════════════════════════════════════════════════════════════════════════════
#  DzRent — Backend Environment Variables
#  Sprint 2.1 (Auth + Users) + Sprint 2.2 stubs (KYC)
# ══════════════════════════════════════════════════════════════════════════════
#
#  SETUP:
#    cp .env.example .env
#    Fill in all CHANGE_ME values before running.
#
#  VALIDATION:
#    The app REFUSES TO START if any required variable is missing or malformed.
#    Validation schema: src/config/config.validation.ts (Joi)
#
#  SECRETS:
#    Generate strong secrets with: openssl rand -hex 32
#    Use separate values for each secret — never reuse across variables.
#
#  DO NOT COMMIT .env — it is in .gitignore.
# ══════════════════════════════════════════════════════════════════════════════


# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Valid values: development | staging | production | test

APP_PORT=3000

# Min 32 chars. Used for HMAC operations (audit log signatures, etc.)
# Generate: openssl rand -hex 32
APP_SECRET=CHANGE_ME_app_secret_min_32_chars_openssl_rand_hex_32

# Comma-separated allowed CORS origins (no trailing slashes)
# Production: use exact frontend domain(s)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000


# ── Database (PostgreSQL 16 + PostGIS 3.4) ───────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# APPLICATION connection.
# In production: route through PgBouncer (:6432) in transaction mode.
# In local dev: connect directly to Postgres (:5432).
DATABASE_URL="postgresql://dzrent:dzrent_dev_secret@localhost:5432/dzrent_dev?schema=public"

# DIRECT connection — bypasses PgBouncer.
# Required for: `prisma migrate deploy`, `prisma db seed`, DDL statements.
# In local dev: identical to DATABASE_URL.
# In production: point to Postgres port directly (:5432), NOT PgBouncer (:6432).
DIRECT_URL="postgresql://dzrent:dzrent_dev_secret@localhost:5432/dzrent_dev?schema=public"

# Docker Compose Postgres credentials — must match the values above.
POSTGRES_USER=dzrent
POSTGRES_PASSWORD=dzrent_dev_secret
POSTGRES_DB=dzrent_dev


# ── JWT ───────────────────────────────────────────────────────────────────────
# CRITICAL: JWT_SECRET and JWT_REFRESH_SECRET MUST be different values.
#
# Why? If they were the same, a refresh token could be used as an access token
# by changing the `type` claim. Different secrets prevent this confusion attack.
#
# Generate both with separate `openssl rand -hex 32` runs.

# Access token — short-lived bearer token for API authentication.
JWT_SECRET=CHANGE_ME_access_token_secret_different_from_refresh
JWT_EXPIRES_IN=15m
# Valid units: s (seconds), m (minutes), h (hours), d (days)
# Recommended: 15m–60m for production.

# Refresh token — long-lived, stored as bcrypt hash in Redis.
# Revoked individually (per-device logout) or in bulk (security events).
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_secret_different_from_access
JWT_REFRESH_EXPIRES_IN=7d
# Recommended: 7d–30d for production.


# ── Redis ─────────────────────────────────────────────────────────────────────
# Required for:
#   • OTP per-phone resend cooldown (60 s key with TTL)
#   • Refresh token revocation store (hashed JTI → hash, TTL = token lifetime)
#   • Sprint 4+: booking event queues (Bull/BullMQ)
#   • Sprint 5+: notification retry queue, GPS event buffer
#
# Local dev: Redis 7 started by docker-compose (redis:7-alpine).
# Production: Hetzner Managed Redis or Redis Cloud.
#             Use rediss:// (double-s) for TLS-encrypted connections.
#
# Format: redis[s]://[:password@]host[:port][/db-number]
REDIS_URL=redis://localhost:6379

# Production example with password and TLS:
# REDIS_URL=rediss://:mypassword@redis.example.com:6380/0


# ── Twilio SMS ────────────────────────────────────────────────────────────────
# Primary OTP delivery channel. Sprint 5 adds Ooredoo/Mobilis Direct API fallback.
#
# ── Local development (no Twilio account needed) ──────────────────────────────
# Leave the placeholder values below as-is.
# SmsModule detects the placeholder SID and switches to ConsoleSmsService.
# OTP codes are printed prominently to stdout — no SMS sent, no cost.
#
#   Look for this in your terminal:
#   ──────────────────────────────────────────────────
#     📲  OTP for +213551234567
#     🔑  Code : 483920
#     ⏱   Valid for 10 minutes
#   ──────────────────────────────────────────────────
#
# ── Staging / Production ──────────────────────────────────────────────────────
# 1. Create a Twilio account: https://www.twilio.com
# 2. Buy a phone number: https://console.twilio.com/us1/develop/phone-numbers
# 3. Replace the placeholder values below with your live credentials.
#
# Algerian SMS notes:
#   - Twilio international SMS reaches +213 but local providers are faster.
#   - OTP messages are always bilingual (French + Arabic) — see TwilioSmsService.
#   - Sprint 5 adds Ooredoo Algeria / Mobilis Direct API as a fallback provider.
#   - Consider a Twilio Messaging Service (MS SID) for better deliverability.

# Account SID — starts with "AC", found in Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token — 32-character hex string, found next to Account SID
# Rotate this immediately if it is ever exposed.
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender phone number in E.164 format (+12125550000)
# Must be a Twilio-provisioned number OR a Messaging Service SID (MGxxxxxxx)
TWILIO_PHONE_NUMBER=+12125550000


# ── Object Storage (S3-compatible) ───────────────────────────────────────────
# Used for KYC documents, vehicle photos, and rental contract PDFs.
#
# Local dev: MinIO started by docker-compose.
#   API:     http://localhost:9000
#   Console: http://localhost:9001  (login: minioadmin / minioadmin)
#   Create buckets on first run or run: pnpm minio:init (Sprint 2.2 script)
#
# Production: Cloudflare R2 (zero egress cost) or AWS S3.
#   Set S3_ENDPOINT to your R2/S3 endpoint.
#   Never expose the secret key — use IAM roles where possible.

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# KYC documents — CIN, permis de conduire, selfie, proof of address
# AES-256 server-side encryption enforced on this bucket (SSE-S3 or SSE-KMS).
# Signed URLs with 5-minute expiry — raw paths NEVER sent to clients.
S3_BUCKET_KYC=dzrent-kyc

# Vehicle photos uploaded by agencies
S3_BUCKET_VEHICLES=dzrent-vehicles

# Rental contract PDFs (unsigned draft + e-signed final version)
S3_BUCKET_CONTRACTS=dzrent-contracts


# ── GPS Webhook (Sprint 3) ────────────────────────────────────────────────────
# HMAC-SHA256 secret used to verify GPS tracker webhook payloads.
# The GPS device signs each payload with this key; the server validates the header.
# Generate: openssl rand -hex 32
GPS_INGEST_SECRET=CHANGE_ME_gps_webhook_secret_min_32_chars


# ══════════════════════════════════════════════════════════════════════════════
#  Sprint 2.2 — KYC Module (upcoming — stubs only, not yet validated)
# ══════════════════════════════════════════════════════════════════════════════
# These variables will be required when KycModule is added in Sprint 2.2.
# Add them to config.validation.ts when the KYC module is implemented.

# OCR / Document verification provider (e.g. AWS Textract or local python-based)
# KYC_OCR_PROVIDER=aws_textract
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1

# Max file size for KYC document uploads (bytes). Default: 10 MB.
# KYC_MAX_FILE_SIZE_BYTES=10485760

# Allowed MIME types for KYC uploads (comma-separated)
# KYC_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
